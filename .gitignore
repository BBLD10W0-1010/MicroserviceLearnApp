# Visual Studio user settings and cache
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.VC.db
*.VC.VC.opendb

# JetBrains Rider and ReSharper
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# VS Code: retain shareable project configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# Test results and code coverage
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage/
coverage.xml
coverage.json
lcov.info
[Cc]overage[Rr]esults*/
[Cc]overage[Rr]eport*/
_NCrunch_*/
.*crunch*.local.xml
nunit-*.xml

# NuGet packages and generated restore files
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Publish output and local publishing credentials
[Pp]ublish/
*.publish.xml
*.pubxml
*.publishproj
PublishScripts/

# Logs, temporary files, and crash dumps
*.log
*.tmp
*.temp
*.bak
*.stackdump
*.dmp
*.pidb
*.svclog

# OS-generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
